row_gap = 0
rows = [
  ["state_icon", "terminal_title_stripped"],
  ["workspace", "tab"],
]
[ui.toast]
delivery = "herdr"

[ui.sound]
enabled = true

[theme]
name = "vesper"
auto_switch = false
