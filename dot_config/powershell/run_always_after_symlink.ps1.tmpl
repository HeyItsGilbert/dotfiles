#!/usr/bin/env pwsh
$ErrorActionPreference = 'Continue'
$ErrorView = 'DetailedView'

# PowerShell profiles live under Documents (often OneDrive). Chezmoi manages the
# XDG copies under ~/.config/powershell; this script mirrors them into the paths
# $PROFILE actually loads.
$Dest = $HOME
if ($Env:OneDriveCommercial) {
  $Dest = $Env:OneDriveCommercial
}
if ($Env:OneDrive) {
  $Dest = $env:OneDrive
}
$Dest = Join-Path $Dest 'Documents'

$ConfigHome = if ($ENV:XDG_CONFIG_HOME) {
  $ENV:XDG_CONFIG_HOME
} else {
  [IO.Path]::Combine($HOME, '.config')
}
$SrcDir = Join-Path $ConfigHome 'powershell'

$FilesToCopy = @{
  'profile.ps1' = @(
    (Join-Path $Dest 'PowerShell\Microsoft.dotnet-interactive_profile.ps1')
  )
}

# On Unix PowerShell loads its profile and configuration directly from the XDG
# directory Chezmoi manages. Only dotnet-interactive needs its Documents-hosted
# compatibility profile. Windows hosts need the legacy Documents mirrors too.
if (-not $IsLinux) {
  $FilesToCopy['profile.ps1'] += @(
    (Join-Path $Dest 'WindowsPowerShell\profile.ps1')
    (Join-Path $Dest 'PowerShell\profile.ps1')
  )
  $FilesToCopy['powershell.config.json'] = @(
    (Join-Path $Dest 'PowerShell\powershell.config.json')
  )
  foreach ($name in @('GitTools.ps1', 'ShellIntegration.ps1', 'Microsoft.VSCode_profile.ps1')) {
    $FilesToCopy[$name] = @(
      (Join-Path $Dest "WindowsPowerShell\$name")
      (Join-Path $Dest "PowerShell\$name")
    )
  }
}

foreach ($name in @($FilesToCopy.Keys)) {
  $src = Join-Path $SrcDir $name
  if (-not (Test-Path -LiteralPath $src)) {
    Write-Warning "Skipping missing source: $src"
    continue
  }

  foreach ($dest in $FilesToCopy[$name]) {
    if ([string]::IsNullOrWhiteSpace($dest)) { continue }
    $parent = Split-Path -Parent $dest
    if (-not (Test-Path -LiteralPath $parent)) {
      New-Item -ItemType Directory -Path $parent -Force | Out-Null
    }
    try {
      Copy-Item -LiteralPath $src -Destination $dest -Force
      Write-Host "Copied $name -> $dest"
    } catch {
      Write-Warning "Failed copying $src -> $dest : $_"
    }
  }
}
