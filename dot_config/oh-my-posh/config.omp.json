{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "black": "#100f0f",
    "red": "#af3029",
    "green": "#66800b",
    "yellow": "#ad8301",
    "blue": "#205ea6",
    "purple": "#5e409d",
    "cyan": "#24837b",
    "white": "#cecdc3",
    "bright-black": "#575653",
    "bright-red": "#d14d41",
    "bright-green": "#879a39",
    "bright-yellow": "#d0a215",
    "bright-blue": "#4385be",
    "bright-purple": "#8b7ec8",
    "bright-cyan": "#3aa99f",
    "bright-white": "#fffcf0"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:purple",
    "template": "❯ "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "powerline",
          "leading_powerline_symbol": "",
          "trailing_powerline_symbol": "",
          "background": "p:purple",
          "foreground": "p:bright-white",
          "template": "{{ if .Root }} ⚡{{ end }}{{ if .SSHSession }}\ueba9 {{ end }}{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:green",
          "foreground": "p:bright-white",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3
          },
          "template": " {{ .Path }}{{ if not .Writable }} {{ end }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:bright-black",
          "foreground": "p:bright-white",
          "options": {
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if or .Working.Changed .Staging.Changed }} <#cecdc3>{{ .Working.String }}{{ .Staging.String }}</>{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "background": "transparent",
          "foreground": "p:bright-white",
          "options": {
            "threshold": 2000,
            "style": "austin",
            "always_enabled": false
          },
          "template": "{{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "plain",
          "background": "transparent",
          "foreground": "p:bright-white",
          "template": "{{ .CurrentDate | date \"15:04:05\" }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "shell",
          "style": "plain",
          "background": "transparent",
          "foreground": "p:bright-cyan",
          "options": {
            "mapped_shell_names": {
              "pwsh": "",
              "powershell": "",
              "bash": "",
              "zsh": "%_",
              "cmd": "",
              "unknown": ""
            }
          },
          "template": "{{ .Name }} "
        },
        {
          "type": "status",
          "style": "plain",
          "background": "transparent",
          "foreground": "p:bright-green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:bright-red{{ end }}"
          ],
          "template": "❯ ",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}