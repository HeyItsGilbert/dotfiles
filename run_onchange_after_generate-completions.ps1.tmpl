{{- /* Rebuild completion cache whenever installed tool versions change */ -}}
{{- if lookPath "chezmoi" }}# chezmoi: {{ output "chezmoi" "--version" | trim | splitList "\n" | first }}{{ end -}}
{{- if lookPath "gh" }}# gh: {{ output "gh" "--version" | trim | splitList "\n" | first }}{{ end -}}
{{- if lookPath "fnm" }}# fnm: {{ output "fnm" "--version" | trim | splitList "\n" | first }}{{ end -}}
{{- if lookPath "zoxide" }}# zoxide: {{ output "zoxide" "--version" | trim | splitList "\n" | first }}{{ end -}}
{{- if lookPath "starship" }}# starship: {{ output "starship" "--version" | trim | splitList "\n" | first }}{{ end }}

$cacheDir = [IO.Path]::Combine($HOME, '.local', 'share', 'powershell', 'CompletionCache')
New-Item -ItemType Directory -Force $cacheDir | Out-Null

$tools = [ordered]@{
    chezmoi  = @{ Args = @('completion', 'powershell'); Native = $true }
    gh       = @{ Args = @('completion', '-s', 'powershell'); Native = $true }
    fnm      = @{ Args = @('env', '--use-on-cd', '--shell', 'powershell'); Native = $false }
    zoxide   = @{ Args = @('init', 'powershell', '--no-cmd', '--hook', 'none'); Native = $false }
    starship = @{ Args = @('init', 'powershell', '--print-full-init'); Native = $false }
}

foreach ($tool in $tools.Keys) {
    $cmd = Get-Command $tool -ErrorAction SilentlyContinue
    if (-not $cmd) { continue }
    $outFile = [IO.Path]::Combine($cacheDir, "$tool.ps1")
    $spec = $tools[$tool]
    & $tool @($spec.Args) | Set-Content $outFile -Encoding UTF8
    if ($spec.Native) {
        $content = Get-Content -LiteralPath $outFile -Raw
        if ($content -match 'Register-ArgumentCompleter' -and $content -notmatch 'Register-ArgumentCompleter\s+-Native\b') {
            $content = $content -replace 'Register-ArgumentCompleter\s+-CommandName', 'Register-ArgumentCompleter -Native -CommandName'
            Set-Content -LiteralPath $outFile -Value $content -Encoding UTF8 -NoNewline
        }
    }
    Write-Host "  cached: $outFile"
}
